# Connection settings for the module 16 Python scripts.
#
# 1. Copy this file and name the copy .env  (same folder)
# 2. Put YOUR password after PGPASSWORD=
#
# .env is listed in .gitignore, so your password is never committed to GitHub.
# Never put a real password in this .env.example file.

PGHOST=localhost
PGPORT=5432
PGDATABASE=ulk_university_db
PGUSER=ulk_admin
PGPASSWORD=change-me
